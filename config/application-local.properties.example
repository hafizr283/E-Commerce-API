# Copy to application-local.properties (ignored by Git). Create the database first.
spring.datasource.url=jdbc:mysql://localhost:3306/atelier_store?serverTimezone=UTC
spring.datasource.username=YOUR_LOCAL_MYSQL_USER
spring.datasource.password=YOUR_LOCAL_MYSQL_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
jwt.secret=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
# Only for a local demonstration; creates documented sample accounts and products.
app.seed-demo=true
